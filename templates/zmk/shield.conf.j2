# Generated by keyboard_firmware_maker
# Keyboard: {{ display_name }}

# Bluetooth (pré-requis pour Split BLE, widgets battery/output, pairing)
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

{% if split %}
# Split wireless
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SPLIT_BLE=y
{% endif %}

# ZMK Studio — remapping en temps réel. Transport choisi par l'utilisateur
# (model.keyboard.zmk_studio_transport) : "ble" (défaut, sans fil, service GATT)
# ou "usb" (CDC ACM filaire, nécessite aussi le snippet studio-rpc-usb-uart
# dans build.yaml). Kconfig choice ZMK_STUDIO_TRANSPORT est exclusif.
CONFIG_ZMK_STUDIO=y
# LOCKING=n : Studio accessible sans unlock behavior préalable
CONFIG_ZMK_STUDIO_LOCKING=n
{% if studio_transport == "usb" %}
# Transport USB sélectionné par l'utilisateur — force le CDC ACM (UART over USB)
CONFIG_ZMK_STUDIO_TRANSPORT_UART=y
{% endif %}

# Power management — idle sleep timeout configurable via OledConfig.sleep_timeout_s
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT={{ idle_sleep_ms }}

# Libère P0.09 et P0.10 du mode NFC antenne (par défaut sur nRF52840) pour les
# utiliser comme GPIO classiques. Sans cette ligne, toute matrice/RGB qui utilise
# ces deux pins se comporte de façon erratique (touches mortes, LEDs aléatoires).
CONFIG_NFCT_PINS_AS_GPIOS=y

{% if has_display %}
# Display — built-in status screen with battery icon
CONFIG_ZMK_DISPLAY=y
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y
CONFIG_ZMK_WIDGET_LAYER_STATUS=y
CONFIG_ZMK_WIDGET_BATTERY_STATUS=y
CONFIG_ZMK_WIDGET_OUTPUT_STATUS=y
{% endif %}

{% if split %}
# Split battery — affiche le niveau des deux moitiés sur l'écran central
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y
{% endif %}

{% if rgb_underglow %}
# RGB Underglow — driver LED_STRIP auto-sélectionné par ZMK_RGB_UNDERGLOW + devicetree
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX={{ rgb_max_brightness }}
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=0
CONFIG_ZMK_RGB_UNDERGLOW_HUE_START=0
CONFIG_ZMK_RGB_UNDERGLOW_SAT_START=100
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=50
{% endif %}

{% if has_encoder %}
# Encoder
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y
{% endif %}
