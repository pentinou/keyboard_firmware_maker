# Generated by keyboard_firmware_maker
# Keyboard: {{ display_name }}

{% if adv_keyboard_name %}
# Nom personnalisé du clavier (onglet "Options avancées" KFM).
CONFIG_ZMK_KEYBOARD_NAME="{{ adv_keyboard_name }}"
{% endif %}

# Bluetooth (pré-requis pour Split BLE, widgets battery/output, pairing)
CONFIG_ZMK_BLE=y
CONFIG_ZMK_USB=y

# Réactivité BLE — slave latency par défaut ZMK = 30 (peripheral peut skipper
# 30 connection events avant de répondre). Multiplié par l'intervalle négocié
# avec l'OS (pouvant aller jusqu'à 500ms sur Windows en idle), ça donne des
# délais de wake jusqu'à 15s perceptibles par l'utilisateur. On baisse à 5 :
#   - cas actif (interval 15ms)    → (5+1)×15 = 90ms (imperceptible)
#   - cas modéré (interval 100ms)  → 6×100   = 600ms
#   - cas extrême (interval 500ms) → 6×500   = 3s (rare, dépend de l'OS)
# Coût conso BLE : +1-2mA en idle radio. Négligeable face au RGB.
CONFIG_BT_PERIPHERAL_PREF_LATENCY=5

{% if split %}
# Split wireless
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SPLIT_BLE=y
{% endif %}

# ZMK Studio — remapping en temps réel. Transport choisi par l'utilisateur
# (model.keyboard.zmk_studio_transport) : "ble" (défaut, sans fil, service GATT)
# ou "usb" (CDC ACM filaire, nécessite aussi le snippet studio-rpc-usb-uart
# dans build.yaml). Kconfig choice ZMK_STUDIO_TRANSPORT est exclusif.
CONFIG_ZMK_STUDIO=y
# LOCKING=n : Studio accessible sans unlock behavior préalable
CONFIG_ZMK_STUDIO_LOCKING=n
{% if studio_transport == "usb" %}
# Transport USB sélectionné par l'utilisateur — force le CDC ACM (UART over USB)
CONFIG_ZMK_STUDIO_TRANSPORT_UART=y
{% endif %}

# Power management — délai deep sleep configurable via Options avancées
# (champ `deep_sleep_timeout_min`). Override possible par OledConfig.sleep_timeout_s
# pour rétro-compatibilité.
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT={{ idle_sleep_ms }}

{% if adv_battery_report_interval_s %}
# Fréquence de rapport batterie via HID (Options avancées).
CONFIG_ZMK_BATTERY_REPORT_INTERVAL={{ adv_battery_report_interval_s }}
{% endif %}
{% if adv_soft_off_enabled %}
# Touche `&soft_off` activée (Options avancées) — extinction logicielle propre.
CONFIG_ZMK_PM_SOFT_OFF=y
CONFIG_ZMK_BEHAVIOR_SOFT_OFF=y
{% endif %}

{% if adv_nkro_enabled %}
# N-Key Rollover (Options avancées) : toutes les touches simultanées détectées.
CONFIG_ZMK_HID_REPORT_TYPE_NKRO=y
{% endif %}
{% if adv_hid_indicators_enabled %}
# HID Indicators (Options avancées) : reçoit CapsLock/NumLock/ScrollLock de l'OS.
CONFIG_ZMK_HID_INDICATORS=y
{% endif %}
{% if adv_usb_boot_protocol %}
# Compatibilité BIOS / firmware de boot (Options avancées).
CONFIG_ZMK_USB_BOOT=y
{% endif %}
{% if adv_ble_passkey_entry %}
# Pairing avec code 6 chiffres (Options avancées). Plus sécurisé que accept-all.
CONFIG_ZMK_BLE_PASSKEY_ENTRY=y
{% endif %}

{% if adv_tap_dance_enabled %}
# Tap-dance behavior (Options avancées) : 1 tap = X, 2 taps = Y, etc.
CONFIG_ZMK_BEHAVIOR_TAP_DANCE=y
{% endif %}
{% if adv_sticky_key_enabled %}
# Sticky keys (Options avancées) : one-shot modifiers.
CONFIG_ZMK_BEHAVIOR_STICKY_KEY=y
{% endif %}

{% if adv_pointing_enabled %}
# Pointing device (Options avancées) : trackball / trackpoint / touchpad.
CONFIG_ZMK_POINTING=y
{% if adv_pointing_smooth_scroll %}
CONFIG_ZMK_POINTING_SMOOTH_SCROLLING=y
{% endif %}
{% endif %}

# Libère P0.09 et P0.10 du mode NFC antenne (par défaut sur nRF52840) pour les
# utiliser comme GPIO classiques. Sans cette ligne, toute matrice/RGB qui utilise
# ces deux pins se comporte de façon erratique (touches mortes, LEDs aléatoires).
CONFIG_NFCT_PINS_AS_GPIOS=y

{% if has_display %}
# Display
CONFIG_ZMK_DISPLAY=y
# Désactive le blanking automatique de l'OLED après idle (=30s par défaut).
# Sans cette ligne, ZMK active CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE=y par défaut
# et envoie SSD1306_DISPLAY_OFF à l'idle ; le wake via activity_state_changed
# peut être défaillant sur ZMK 4.1 + Zephyr récent. L'anti-burn-in passe
# par kfm_anti_burnin.c (inversion 1 s/min) au lieu du blanking — voir
# CONFIG_KFM_ANTI_BURNIN ci-dessous quand activé.
CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE=n
{% if oled_custom_screen %}
# Status screen custom — fichier status_screen.c généré par KFM, compilé via
# CMakeLists.txt du shield. L'image affichée est la composition des éléments
# placés sur le canvas de l'éditeur OLED de KFM (rotation 90° CW au build-time).
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y
# Active le widget LVGL "image" (lv_image_create / lv_image_set_src). Désactivé
# par défaut sous LV_CONF_MINIMAL=y de ZMK — sans ce flag, undefined references
# au link sur lv_image_create/set_src.
CONFIG_LV_USE_IMAGE=y
{# Activation conditionnelle des widgets ZMK natifs selon ce qui a été placé.
   On vérifie chaque côté pour activer le Kconfig correspondant — les Kconfig
   sont globaux au build, ils sont activés dès qu'au moins une moitié l'utilise. #}
{% set all_widgets = oled_widgets_left + oled_widgets_right %}
{% if all_widgets | selectattr("type", "equalto", "battery") | list %}
CONFIG_ZMK_WIDGET_BATTERY_STATUS=y
{% endif %}
{% if all_widgets | selectattr("type", "equalto", "output") | list %}
CONFIG_ZMK_WIDGET_OUTPUT_STATUS=y
{% endif %}
{% if all_widgets | selectattr("type", "equalto", "layer") | list %}
CONFIG_ZMK_WIDGET_LAYER_STATUS=y
{% endif %}
{% if all_widgets | selectattr("type", "equalto", "peripheral") | list %}
CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS=y
{% endif %}
{% else %}
# Status screen built-in (par défaut) : layer + batterie + output
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILT_IN=y
CONFIG_ZMK_WIDGET_LAYER_STATUS=y
CONFIG_ZMK_WIDGET_BATTERY_STATUS=y
CONFIG_ZMK_WIDGET_OUTPUT_STATUS=y
{% endif %}
{% if show_battery_percentage %}
# Affiche le pourcentage en texte à côté de l'icône batterie (option KFM)
CONFIG_ZMK_WIDGET_BATTERY_STATUS_SHOW_PERCENTAGE=y
{% endif %}
{% endif %}

{% if split %}
# Split battery — affiche le niveau des deux moitiés sur l'écran central
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y
{% endif %}

{% if rgb_underglow %}
# RGB Underglow — driver LED_STRIP auto-sélectionné par ZMK_RGB_UNDERGLOW + devicetree
CONFIG_ZMK_RGB_UNDERGLOW=y
CONFIG_ZMK_RGB_UNDERGLOW_BRT_MAX={{ rgb_max_brightness }}
CONFIG_ZMK_RGB_UNDERGLOW_EFF_START=0
# Couleur de démarrage configurable via Options avancées (HUE 0-359 → 0=rouge,
# 120=vert, 240=bleu). Défaut 0 si pas réglé.
CONFIG_ZMK_RGB_UNDERGLOW_HUE_START={{ adv_rgb_hue_start | default(0) }}
CONFIG_ZMK_RGB_UNDERGLOW_SAT_START=100
CONFIG_ZMK_RGB_UNDERGLOW_BRT_START=50
{% if not adv_rgb_on_start %}
# LEDs éteintes au boot (Options avancées). Sans cette ligne, allumées par défaut.
CONFIG_ZMK_RGB_UNDERGLOW_ON_START=n
{% endif %}
{% if adv_rgb_auto_off_idle %}
# RGB éteint en idle (Options avancées) — économie batterie significative.
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_IDLE=y
{% endif %}
{% if adv_rgb_auto_off_usb %}
# RGB éteint quand USB débranché (Options avancées).
CONFIG_ZMK_RGB_UNDERGLOW_AUTO_OFF_USB=y
{% endif %}

{% if oled_shares_ext_power %}
# Sur ce clavier (flag YAML `rgb.oled_shares_ext_power: true`), l'OLED est
# câblé sur la même rail VCC commutée par ext_power (P0.13 sur nice_nano v2)
# que la chaîne LED. Si on laissait EXT_POWER=y (défaut ZMK), `RGB_TOG OFF`
# couperait aussi l'OLED qui ne se réinitialise pas au retour → écran noir
# permanent. On force EXT_POWER=n : les LEDs gardent leur VDD en quiescent
# (~1 mA × led_count) mais l'OLED survit aux toggles RGB.
CONFIG_ZMK_RGB_UNDERGLOW_EXT_POWER=n
{% endif %}
{% endif %}

{% if has_encoder %}
# Encoder
CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y
{% endif %}

{% if anti_burnin %}
# ── Anti-marquage OLED (KFM) ───────────────────────────────────────────────────
# Le fichier kfm_anti_burnin.c (compilé via CMakeLists.txt du shield) envoie
# toutes les 60s une commande SSD1306 0xA7 (invert) pendant 1s, puis 0xA6
# (normal). Pas de Kconfig dédié : le fichier est compilé inconditionnellement
# si présent, et le shell logging Zephyr signale son init dans les logs debug.
{% endif %}
{% if debug_logging %}
# ── Mode debug logging KFM ─────────────────────────────────────────────────────
# Active le logging Zephyr/ZMK sur USB CDC ACM. Permet de capturer les messages
# de boot (panic, k_oops, init OLED/BLE/USB, etc.) avec :
#   screen /dev/ttyACM0 115200      # Linux/Mac
#   picocom /dev/ttyACM0 -b 115200
# ⚠ Augmente significativement la taille flash et la conso énergétique BLE.
# À désactiver pour les firmwares de production.
CONFIG_LOG=y
CONFIG_LOG_DEFAULT_LEVEL=4
CONFIG_LOG_MODE_DEFERRED=y
CONFIG_LOG_BACKEND_UART=y
CONFIG_USB_DEVICE_STACK=y
CONFIG_USB_CDC_ACM=y
CONFIG_UART_LINE_CTRL=y
CONFIG_SERIAL=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
{% endif %}
