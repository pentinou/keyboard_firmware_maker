/*
 * Generated by keyboard_firmware_maker — kfm_anti_burnin.c
 * Keyboard: {{ display_name }}
 *
 * Anti-marquage OLED : envoie périodiquement la commande hardware SSD1306
 * 0xA7 (DISPLAY_INVERT) pendant 1 s, puis 0xA6 (DISPLAY_NORMAL) pendant 59 s.
 * Cycle indéfini tant que l'écran est sous tension.
 *
 * Mécanique :
 *  - On accède au bus I2C parent du device chosen `zephyr,display` via DT_BUS.
 *  - L'adresse I2C du SSD1306 vient de DT_REG_ADDR.
 *  - On envoie 2 octets : [control_byte = 0x00 (Co=0, D/C#=0 = command), cmd].
 *  - L'inversion est atomique côté hardware : le buffer LVGL n'est pas touché,
 *    seul le contrôleur OLED inverse les pixels à la volée.
 *
 * Avantage vs blanking (CONFIG_ZMK_DISPLAY_BLANK_ON_IDLE) :
 *  - Pas de risque de wake défaillant (bug ZMK 4.1 + Zephyr récent).
 *  - L'écran reste lisible (juste inversé pendant 1 s) au lieu d'être noir.
 *  - Identique au comportement QMK historique.
 */

#include <zephyr/kernel.h>
#include <zephyr/devicetree.h>
#include <zephyr/drivers/i2c.h>
#include <zephyr/logging/log.h>

LOG_MODULE_REGISTER(kfm_anti_burnin, CONFIG_DISPLAY_LOG_LEVEL);

#define DISPLAY_NODE        DT_CHOSEN(zephyr_display)

#if DT_NODE_EXISTS(DISPLAY_NODE) && DT_ON_BUS(DISPLAY_NODE, i2c)

#define DISPLAY_I2C_BUS     DEVICE_DT_GET(DT_BUS(DISPLAY_NODE))
#define DISPLAY_I2C_ADDR    DT_REG_ADDR(DISPLAY_NODE)

/* SSD1306 commands (datasheet §10.1) */
#define SSD1306_CMD_NORMAL  0xA6
#define SSD1306_CMD_INVERT  0xA7
#define SSD1306_CTRL_CMD    0x00  /* Co=0, D/C#=0 — single command byte */

static void invert_handler(struct k_work *work);
static void restore_handler(struct k_work *work);
static K_WORK_DELAYABLE_DEFINE(invert_work, invert_handler);
static K_WORK_DELAYABLE_DEFINE(restore_work, restore_handler);

static int send_command(uint8_t cmd) {
    const struct device *i2c = DISPLAY_I2C_BUS;
    if (!device_is_ready(i2c)) {
        LOG_WRN("I2C bus not ready");
        return -ENODEV;
    }
    uint8_t buf[2] = {SSD1306_CTRL_CMD, cmd};
    int ret = i2c_write(i2c, buf, sizeof(buf), DISPLAY_I2C_ADDR);
    if (ret < 0) {
        LOG_WRN("i2c_write 0x%02x failed: %d", cmd, ret);
    }
    return ret;
}

static void invert_handler(struct k_work *work) {
    send_command(SSD1306_CMD_INVERT);
    /* Reste inversé 1 s puis restore */
    k_work_schedule(&restore_work, K_MSEC(1000));
}

static void restore_handler(struct k_work *work) {
    send_command(SSD1306_CMD_NORMAL);
    /* Re-inverser dans 59 s (cycle total = 60 s) */
    k_work_schedule(&invert_work, K_SECONDS(59));
}

static int kfm_anti_burnin_init(void) {
    /* Premier cycle après 60 s pour laisser le display s'initialiser */
    k_work_schedule(&invert_work, K_SECONDS(60));
    LOG_INF("KFM anti-burnin armed (invert 1s every 60s on display@0x%02x)",
            DISPLAY_I2C_ADDR);
    return 0;
}

/* APPLICATION + priority 99 : démarre après tous les drivers et l'init display.
 * Le device i2c sera ready à ce moment, et le premier work est dans 60 s. */
SYS_INIT(kfm_anti_burnin_init, APPLICATION, 99);

#else /* DISPLAY non I2C ou inexistant */

/* Pas de display I2C détecté en devicetree — anti-burnin désactivé. */

#endif
