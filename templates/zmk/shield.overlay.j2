/*
 * Generated by keyboard_firmware_maker — DO NOT EDIT
 * Keyboard: {{ display_name }} / MCU: {{ mcu }}
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    chosen {
        zmk,physical-layout = &physical_layout0;
{% if has_encoder %}
        zmk,keymap-sensors = &sensors;
{% endif %}
{% if has_display %}
        zephyr,display = &oled;
{% endif %}
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "{{ diode_direction_zmk }}";
        wakeup-source;
{% if not split %}
        row-gpios = {{ row_gpios_left }}
            ;
        col-gpios = {{ col_gpios_left }}
            ;
{% endif %}
    };

{% if has_encoder %}
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <{{ encoder_a }} (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <{{ encoder_b }} (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
{% endif %}

    default_transform: matrix_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <{{ matrix_rows_total }}>;
        columns = <{{ matrix_cols }}>;
        map = <
{{ matrix_transform_map }}
        >;
    };

    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "{{ display_name }}";
        transform = <&default_transform>;
        kscan = <&kscan0>;
{{ physical_layout_keys }}
    };
};

{% if has_display %}
&pro_micro_i2c {
    status = "okay";

    oled: {{ oled_driver }}@3c {
        compatible = "solomon,{{ oled_driver }}fb";
        reg = <0x3c>;
        width = <{{ oled_width }}>;
        height = <{{ oled_height }}>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <{{ oled_multiplex }}>;
        prechargep = <0x22>;
        segment-remap;
        com-invdir;
{% if oled_height <= 32 %}
        com-sequential;
{% endif %}
    };
};
{% endif %}
