/*
 * Generated by keyboard_firmware_maker — ZMK custom OLED status screen
 * Keyboard: {{ display_name }}
 * Side: {{ oled_side }}
 *
 * Phases :
 *  1. Image plein écran 128×32 (rotation 90° CW depuis canvas 32×128 KFM).
 *  2. Widgets ZMK natifs (battery / output / layer / peripheral) instanciés via
 *     les helpers ZMK et positionnés en coordonnées LVGL.
 *  3. Animations multi-frames LVGL (k_timer + k_work pour dispatch hors ISR).
 *  4. Layer-aware : si une image est assignée à une couche keymap (`img.layer != -1`),
 *     génération d'arrays par-couche + listener `zmk_layer_state_changed` qui swap
 *     la source LVGL et redémarre le timer avec les délais de la nouvelle couche.
 *
 * Pour personnaliser : utiliser l'éditeur OLED de KFM. Ne pas éditer ce fichier
 * à la main, il est régénéré à chaque build.
 */

#include <lvgl.h>
#include <zephyr/kernel.h>
#include <zmk/display.h>

{% if oled_widgets | selectattr("type", "equalto", "battery") | list -%}
#include <zmk/display/widgets/battery_status.h>
{% endif -%}
{% if oled_widgets | selectattr("type", "equalto", "output") | list -%}
#include <zmk/display/widgets/output_status.h>
{% endif -%}
{% if oled_widgets | selectattr("type", "equalto", "layer") | list -%}
#include <zmk/display/widgets/layer_status.h>
{% endif -%}
{% if oled_widgets | selectattr("type", "equalto", "peripheral") | list -%}
#include <zmk/display/widgets/peripheral_status.h>
{% endif %}

{% if oled_has_image %}

{% if oled_layered.has_layer_aware %}
/* === Phase 4 — Layer-aware composite ============================================
 * Une couche -1 (fallback) + une couche par layer keymap où l'utilisateur a
 * assigné des images. Le listener `zmk_layer_state_changed` swap les pointeurs
 * `current_frames` / `current_delays` selon la couche la plus haute active.
 */

{% for L in oled_layered.layers %}
{% set layer_suffix = (L.layer | string) if L.layer >= 0 else "default" %}
/* Couche {{ L.layer }} ({{ layer_suffix }}) — {{ L.frames | length }} frame(s) */
{% for frame_data in L.frames %}
static const uint8_t status_screen_layer_{{ layer_suffix }}_frame_{{ loop.index0 }}_data[] = {
    {{ frame_data }}
};
{% endfor %}

static const lv_image_dsc_t status_screen_layer_{{ layer_suffix }}_frames[] = {
{% for frame_data in L.frames %}
    {
        .header = { .magic = LV_IMAGE_HEADER_MAGIC, .cf = LV_COLOR_FORMAT_I1, .w = 128, .h = 32, .stride = 16 },
        .data = status_screen_layer_{{ layer_suffix }}_frame_{{ loop.index0 }}_data,
        .data_size = sizeof(status_screen_layer_{{ layer_suffix }}_frame_{{ loop.index0 }}_data),
    },
{% endfor %}
};

static const uint16_t status_screen_layer_{{ layer_suffix }}_delays_ms[] = {
    {{ L.delays | join(", ") }}
};

{% endfor %}

/* État global : pointeurs vers la couche actuellement active. Initialisés sur
   la couche -1 (default fallback), mis à jour par le listener layer. */
static const lv_image_dsc_t *current_frames = status_screen_layer_default_frames;
static const uint16_t *current_delays = status_screen_layer_default_delays_ms;
static size_t current_frames_count = ARRAY_SIZE(status_screen_layer_default_frames);

static lv_obj_t *status_screen_anim_obj = NULL;
static int status_screen_anim_idx = 0;

static void status_screen_anim_work_handler(struct k_work *work) {
    if (status_screen_anim_obj != NULL) {
        lv_image_set_src(status_screen_anim_obj, &current_frames[status_screen_anim_idx]);
    }
}
K_WORK_DEFINE(status_screen_anim_work, status_screen_anim_work_handler);

static void status_screen_anim_timer_cb(struct k_timer *t) {
    if (current_frames_count <= 1) return;
    status_screen_anim_idx = (status_screen_anim_idx + 1) % current_frames_count;
    k_work_submit(&status_screen_anim_work);
    k_timer_start(t, K_MSEC(current_delays[status_screen_anim_idx]), K_NO_WAIT);
}
K_TIMER_DEFINE(status_screen_anim_timer, status_screen_anim_timer_cb, NULL);

#include <zmk/event_manager.h>
#include <zmk/events/layer_state_changed.h>
#include <zmk/keymap.h>

/* Layer change handler — exécuté hors ISR (work queue) car LVGL ops ne sont pas
   safe en contexte event_manager direct. Stoppe le timer, swap pointeurs vers
   la couche active, redémarre le timer si la couche a une animation. */
static void status_screen_layer_work_handler(struct k_work *work) {
    int hi = zmk_keymap_highest_layer_active();
    switch (hi) {
{% for L in oled_layered.layers %}
{% if L.layer >= 0 %}
        case {{ L.layer }}:
            current_frames = status_screen_layer_{{ L.layer }}_frames;
            current_delays = status_screen_layer_{{ L.layer }}_delays_ms;
            current_frames_count = ARRAY_SIZE(status_screen_layer_{{ L.layer }}_frames);
            break;
{% endif %}
{% endfor %}
        default:
            current_frames = status_screen_layer_default_frames;
            current_delays = status_screen_layer_default_delays_ms;
            current_frames_count = ARRAY_SIZE(status_screen_layer_default_frames);
            break;
    }
    status_screen_anim_idx = 0;
    k_timer_stop(&status_screen_anim_timer);
    if (status_screen_anim_obj != NULL) {
        lv_image_set_src(status_screen_anim_obj, &current_frames[0]);
    }
    if (current_frames_count > 1) {
        k_timer_start(&status_screen_anim_timer, K_MSEC(current_delays[0]), K_NO_WAIT);
    }
}
K_WORK_DEFINE(status_screen_layer_work, status_screen_layer_work_handler);

static int status_screen_layer_listener(const zmk_event_t *eh) {
    k_work_submit(&status_screen_layer_work);
    return ZMK_EV_EVENT_BUBBLE;
}
ZMK_LISTENER(status_screen_layer, status_screen_layer_listener);
ZMK_SUBSCRIPTION(status_screen_layer, zmk_layer_state_changed);

{% else %}
/* === Phase 3 — single-composite ================================================= */

{% for frame_data in oled_animation.frames %}
/* Frame {{ loop.index0 }} — palette + bitmap LVGL INDEXED_1BIT 128×32 */
static const uint8_t status_screen_frame_{{ loop.index0 }}_data[] = {
    {{ frame_data }}
};
{% endfor %}

static const lv_image_dsc_t status_screen_frames[] = {
{% for frame_data in oled_animation.frames %}
    {
        .header = { .magic = LV_IMAGE_HEADER_MAGIC, .cf = LV_COLOR_FORMAT_I1, .w = 128, .h = 32, .stride = 16 },
        .data = status_screen_frame_{{ loop.index0 }}_data,
        .data_size = sizeof(status_screen_frame_{{ loop.index0 }}_data),
    },
{% endfor %}
};

{% if oled_animation.animated %}
static const uint16_t status_screen_frame_delays_ms[] = {
    {{ oled_animation.delays | join(", ") }}
};

static lv_obj_t *status_screen_anim_obj = NULL;
static int status_screen_anim_idx = 0;

static void status_screen_anim_work_handler(struct k_work *work) {
    if (status_screen_anim_obj != NULL) {
        lv_image_set_src(status_screen_anim_obj, &status_screen_frames[status_screen_anim_idx]);
    }
}
K_WORK_DEFINE(status_screen_anim_work, status_screen_anim_work_handler);

static void status_screen_anim_timer_cb(struct k_timer *t) {
    status_screen_anim_idx = (status_screen_anim_idx + 1) % ARRAY_SIZE(status_screen_frames);
    k_work_submit(&status_screen_anim_work);
    k_timer_start(t, K_MSEC(status_screen_frame_delays_ms[status_screen_anim_idx]), K_NO_WAIT);
}
K_TIMER_DEFINE(status_screen_anim_timer, status_screen_anim_timer_cb, NULL);
{% endif %}

{% endif %}
{% endif %}

{% for w in oled_widgets %}
{% if w.type == "battery" %}
#ifdef CONFIG_ZMK_WIDGET_BATTERY_STATUS
static struct zmk_widget_battery_status battery_widget;
#endif
{% elif w.type == "output" %}
#ifdef CONFIG_ZMK_WIDGET_OUTPUT_STATUS
static struct zmk_widget_output_status output_widget;
#endif
{% elif w.type == "layer" %}
#ifdef CONFIG_ZMK_WIDGET_LAYER_STATUS
static struct zmk_widget_layer_status layer_widget;
#endif
{% elif w.type == "peripheral" %}
#ifdef CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS
static struct zmk_widget_peripheral_status peripheral_widget;
#endif
{% endif %}
{% endfor %}

lv_obj_t *zmk_display_status_screen(void) {
    lv_obj_t *screen = lv_obj_create(NULL);

{% if oled_has_image %}
    /* Image de fond plein écran. */
    lv_obj_t *bg_img = lv_image_create(screen);
{% if oled_layered.has_layer_aware %}
    /* Layer-aware : initialiser sur la frame 0 de la couche par défaut.
       Le listener réajustera dès le premier `zmk_layer_state_changed`. */
    lv_image_set_src(bg_img, &status_screen_layer_default_frames[0]);
    lv_obj_align(bg_img, LV_ALIGN_TOP_LEFT, 0, 0);
    status_screen_anim_obj = bg_img;
    status_screen_anim_idx = 0;
    if (current_frames_count > 1) {
        k_timer_start(&status_screen_anim_timer, K_MSEC(current_delays[0]), K_NO_WAIT);
    }
{% else %}
    lv_image_set_src(bg_img, &status_screen_frames[0]);
    lv_obj_align(bg_img, LV_ALIGN_TOP_LEFT, 0, 0);
{% if oled_animation.animated %}
    status_screen_anim_obj = bg_img;
    status_screen_anim_idx = 0;
    k_timer_start(&status_screen_anim_timer,
                  K_MSEC(status_screen_frame_delays_ms[0]), K_NO_WAIT);
{% endif %}
{% endif %}
{% endif %}

{% for w in oled_widgets %}
{% if w.type == "battery" %}
#ifdef CONFIG_ZMK_WIDGET_BATTERY_STATUS
    zmk_widget_battery_status_init(&battery_widget, screen);
    lv_obj_set_pos(zmk_widget_battery_status_obj(&battery_widget), {{ w.x }}, {{ w.y }});
#endif
{% elif w.type == "output" %}
#ifdef CONFIG_ZMK_WIDGET_OUTPUT_STATUS
    zmk_widget_output_status_init(&output_widget, screen);
    lv_obj_set_pos(zmk_widget_output_status_obj(&output_widget), {{ w.x }}, {{ w.y }});
#endif
{% elif w.type == "layer" %}
#ifdef CONFIG_ZMK_WIDGET_LAYER_STATUS
    zmk_widget_layer_status_init(&layer_widget, screen);
    lv_obj_set_pos(zmk_widget_layer_status_obj(&layer_widget), {{ w.x }}, {{ w.y }});
#endif
{% elif w.type == "peripheral" %}
#ifdef CONFIG_ZMK_WIDGET_PERIPHERAL_STATUS
    zmk_widget_peripheral_status_init(&peripheral_widget, screen);
    lv_obj_set_pos(zmk_widget_peripheral_status_obj(&peripheral_widget), {{ w.x }}, {{ w.y }});
#endif
{% endif %}
{% endfor %}

    return screen;
}
