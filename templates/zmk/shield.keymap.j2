/*
 * Generated by keyboard_firmware_maker — DO NOT EDIT
 * Keyboard: {{ display_name }}
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
{% if rgb_underglow %}
#include <dt-bindings/zmk/rgb.h>
{% endif %}

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
{{ default_bindings }}
            >;
{% if has_encoder %}
            sensor-bindings = <{{ default_sensor_bindings }}>;
{% endif %}
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
{{ lower_bindings }}
            >;
{% if has_encoder %}
            sensor-bindings = <{{ lower_sensor_bindings }}>;
{% endif %}
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
{{ raise_bindings }}
            >;
{% if has_encoder %}
            sensor-bindings = <{{ raise_sensor_bindings }}>;
{% endif %}
        };

        /*
         * Couche Bluetooth — accessible via tri-layer (LOWER + RAISE).
         * Touches (sur les 9 premières positions du clavier) :
         *   1. BT_CLR      : efface le profil BLE actif (pour ré-appairer)
         *   2-6. BT_SEL 0..4 : sélectionne le profil BLE 1 à 5
         *   7. OUT_USB     : force l'envoi HID en USB
         *   8. OUT_BLE     : force l'envoi HID en Bluetooth
         *   9. OUT_TOG     : toggle USB/BLE
         */
        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
{{ bluetooth_bindings }}
            >;
{% if has_encoder %}
            sensor-bindings = <{{ bluetooth_sensor_bindings }}>;
{% endif %}
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        /* Tri-layer : LOWER (1) + RAISE (2) actifs simultanément → Bluetooth (3) */
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
