# Generated by keyboard_firmware_maker
# Push this to a zmk-config repo and enable GitHub Actions to build firmware.
---
include:
{% if split %}
  - board: {{ zmk_board }}
    shield: {{ shield_name }}_left{% if nice_view %} nice_view_adapter nice_view{% endif %}

    snippet: studio-rpc-usb-uart
  - board: {{ zmk_board }}
    shield: {{ shield_name }}_right{% if nice_view %} nice_view_adapter nice_view{% endif %}

{% else %}
  - board: {{ zmk_board }}
    shield: {{ shield_name }}{% if nice_view %} nice_view_adapter nice_view{% endif %}

    snippet: studio-rpc-usb-uart
{% endif %}
