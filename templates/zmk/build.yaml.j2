# Generated by keyboard_firmware_maker
# Push this to a zmk-config repo and enable GitHub Actions to build firmware.
# Note : Studio transport (BLE ou USB) piloté par model.keyboard.zmk_studio_transport.
# En mode USB, le snippet studio-rpc-usb-uart est ajouté à la moitié centrale
# (= left en split, ou la seule cible en non-split).
---
include:
{% if split %}
  - board: {{ zmk_board }}
    shield: {{ shield_name }}_left{% if nice_view %} nice_view_adapter nice_view{% endif %}{% if studio_transport == "usb" %}
    snippet: studio-rpc-usb-uart{% endif %}
  - board: {{ zmk_board }}
    shield: {{ shield_name }}_right{% if nice_view %} nice_view_adapter nice_view{% endif %}
{% else %}
  - board: {{ zmk_board }}
    shield: {{ shield_name }}{% if nice_view %} nice_view_adapter nice_view{% endif %}{% if studio_transport == "usb" %}
    snippet: studio-rpc-usb-uart{% endif %}
{% endif %}
  - board: {{ zmk_board }}
    shield: settings_reset
