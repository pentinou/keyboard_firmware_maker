# Generated by keyboard_firmware_maker — shield CMakeLists
# Keyboard: {{ display_name }}
#
# Compile le status_screen.c custom uniquement quand l'utilisateur a défini un
# layout OLED custom dans KFM (CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM=y).
# Sinon ZMK utilise son status screen built-in (battery + layer + output).

if(CONFIG_ZMK_DISPLAY_STATUS_SCREEN_CUSTOM)
{% if split %}
    if(CONFIG_SHIELD_{{ shield_name_upper }}_LEFT)
        target_sources(app PRIVATE status_screen_left.c)
    elseif(CONFIG_SHIELD_{{ shield_name_upper }}_RIGHT)
        target_sources(app PRIVATE status_screen_right.c)
    endif()
{% else %}
    target_sources(app PRIVATE status_screen.c)
{% endif %}
endif()
