/*
 * Generated by keyboard_firmware_maker — DO NOT EDIT
 * Keyboard: {{ display_name }} / MCU: {{ mcu }}
 * Shared devicetree include for split halves.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
{% if has_encoder %}
        zmk,keymap-sensors = &sensors;
{% endif %}
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "{{ diode_direction_zmk }}";
    };

{% if has_encoder %}
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <{{ encoder_a }} (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <{{ encoder_b }} (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };
{% endif %}

    default_transform: matrix_transform_0 {
        compatible = "zmk,matrix-transform";
        rows = <{{ matrix_rows_total }}>;
        columns = <{{ matrix_cols }}>;
        map = <
{{ matrix_transform_map }}
        >;
    };
};
