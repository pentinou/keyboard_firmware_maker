/* ── Stars ───────────────────────────────────────────────────────────────── */
#ifdef ENABLE_STARS
static bool od_stars_setup = false;
struct OdCoordinate { int x; int y; bool exists; };
static struct OdCoordinate od_stars[TOTAL_STARS];

static void od_setup_stars(void) {
    for (int line = 0; line < NUMBER_OF_STAR_LINES; ++line) {
        for (int cg = 0; cg < STARS_PER_LINE; ++cg) {
            uint8_t rc = rand() % 10;
            uint8_t rr = rand() % 10;
            if (rc < 8 && rr < 8) {
                int x = rc + cg * 8;
                int y = rr + line * 8;
                oled_write_pixel(x, y, true);
                od_stars[cg + line * STARS_PER_LINE].x = x;
                od_stars[cg + line * STARS_PER_LINE].y = y;
                od_stars[cg + line * STARS_PER_LINE].exists = true;
            } else {
                od_stars[cg + line * STARS_PER_LINE].exists = false;
            }
        }
    }
    od_stars_setup = true;
}

static void od_twinkle_stars(void) {
    for (int line = 0; line < NUMBER_OF_STAR_LINES; ++line) {
        for (int cg = 0; cg < STARS_PER_LINE; ++cg) {
            struct OdCoordinate star = od_stars[cg + line * STARS_PER_LINE];
            if (!star.exists) continue;
            if (rand() % TWINKLE_PROBABILITY_MODULATOR == 0) {
                oled_write_pixel(star.x, star.y, false);
                if (star.x == cg * 8) star.x++;
                else if (star.x == ((cg + 1) * 8) - 1) star.x--;
                if (star.y == line * 8) star.y++;
                else if (star.y == ((line + 1) * 8) - 1) star.y--;
                int xc = rand() % 3;
                int new_x = (xc == 0) ? star.x - 1 : (xc == 1) ? star.x + 1 : star.x;
                int yc = rand() % 3;
                int new_y = (yc == 0) ? star.y - 1 : (yc == 1) ? star.y + 1 : star.y;
                star.x = new_x;
                star.y = new_y;
                oled_write_pixel(new_x, new_y, true);
            }
            od_stars[cg + line * STARS_PER_LINE] = star;
        }
    }
}

static void od_animate_stars(void) {
    if (!od_stars_setup) { od_setup_stars(); } else { od_twinkle_stars(); }
}
