/* ── Main render function ────────────────────────────────────────────────── */
void render_ocean_dream(void) {
    if (timer_elapsed32(od_anim_timer) > STARRY_NIGHT_ANIM_FRAME_DURATION) {
        od_anim_timer = timer_read32();
        od_current_wpm = get_current_wpm();

#ifdef ENABLE_MOON
        od_draw_moon();
#endif
#ifdef ENABLE_ISLAND
        od_animate_island();
#endif
#ifdef ENABLE_SHOOTING_STARS
        if (od_animation_counter % SHOOTING_STAR_ANIMATION_MODULATOR == 0) {
            od_animate_shooting_stars();
        }
#endif
#ifdef ENABLE_STARS
        if (od_animation_counter % STAR_ANIMATION_MODULATOR == 0) {
            od_animate_stars();
        }
#endif
#ifdef ENABLE_WAVE
        if (od_animation_counter % OCEAN_ANIMATION_MODULATOR == 0) {
            od_animate_waves();
        }
#endif
        od_animation_counter = od_increment_counter(od_animation_counter, NUMBER_OF_FRAMES);
    }
}
