/* ── Shooting Stars ──────────────────────────────────────────────────────── */
#ifdef ENABLE_SHOOTING_STARS
static bool od_shooting_stars_setup = false;
struct OdShootingStar { int x_1; int y_1; int x_2; int y_2; bool running; int frame; int delay; };
static struct OdShootingStar od_shooting_stars[MAX_NUMBER_OF_SHOOTING_STARS];

static void od_setup_shooting_star(struct OdShootingStar *ss) {
    int col = rand() % (OD_WIDTH / 2);
    int row = rand() % (OD_HEIGHT - 48);
    ss->x_1 = col; ss->y_1 = row;
    ss->x_2 = col + 1; ss->y_2 = row + 1;
    ss->running = true; ss->frame++;
    ss->delay = rand() % SHOOTING_STAR_DELAY;
}

static void od_move_shooting_star(struct OdShootingStar *ss) {
    oled_write_pixel(ss->x_1, ss->y_1, false);
    oled_write_pixel(ss->x_2, ss->y_2, false);
    ss->x_1++; ss->y_1++; ss->x_2++; ss->y_2++; ss->frame++;
    oled_write_pixel(ss->x_1, ss->y_1, true);
    oled_write_pixel(ss->x_2, ss->y_2, true);
}

static void od_finish_shooting_star(struct OdShootingStar *ss) {
    oled_write_pixel(ss->x_1, ss->y_1, false);
    oled_write_pixel(ss->x_2, ss->y_2, false);
    ss->running = false; ss->frame = 0;
}

static void od_animate_shooting_star(struct OdShootingStar *ss) {
    if (ss->frame > SHOOTING_STAR_FRAMES) { od_finish_shooting_star(ss); return; }
    else if (!ss->running) { od_setup_shooting_star(ss); }
    else { if (ss->delay == 0) { od_move_shooting_star(ss); } else { ss->delay--; } }
}

static void od_animate_shooting_stars(void) {
    if (od_is_calm) return;
    if (!od_shooting_stars_setup) {
        for (int i = 0; i < MAX_NUMBER_OF_SHOOTING_STARS; ++i) od_shooting_stars[i].running = false;
        od_shooting_stars_setup = true;
    }
    int n = od_current_wpm / SHOOTING_STAR_WPM_INCREMENT;
    if (n > MAX_NUMBER_OF_SHOOTING_STARS) n = MAX_NUMBER_OF_SHOOTING_STARS;
    for (int i = 0; i < MAX_NUMBER_OF_SHOOTING_STARS; ++i) {
        if (i < n) {
            struct OdShootingStar ss = od_shooting_stars[i];
            od_animate_shooting_star(&ss);
            od_shooting_stars[i] = ss;
        } else if (od_shooting_stars[i].running) {
            od_finish_shooting_star(&od_shooting_stars[i]);
        }
    }
}
