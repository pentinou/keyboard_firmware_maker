# Generated by keyboard_firmware_maker
# Keyboard : {{ keyboard_model }} / MCU : {{ mcu }}
# DO NOT EDIT — regenerate from the application

MCU = {{ mcu | upper | replace("-", "_") }}
BOOTLOADER = {{ bootloader }}

{% if oled_enabled %}
OLED_ENABLE = yes
OLED_DRIVER = {{ oled_driver }}
{% endif %}

{% if wpm_needed %}
WPM_ENABLE = yes
{% endif %}

{% if rgb_enabled %}
RGB_MATRIX_ENABLE = yes
RGB_MATRIX_DRIVER = ws2812
{% if pins.ws2812_driver %}
WS2812_DRIVER = {{ pins.ws2812_driver }}
{% endif %}
{% if has_custom_effects %}
RGB_MATRIX_CUSTOM_USER = yes
{% endif %}
{% endif %}

{% if pins.serial_driver %}
SERIAL_DRIVER = {{ pins.serial_driver }}
{% endif %}

LTO_ENABLE = yes
