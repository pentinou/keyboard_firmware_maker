// Generated by keyboard_firmware_maker
// Keyboard : {{ keyboard_model }} / MCU : {{ mcu }}
// DO NOT EDIT — regenerate from the application

#include QMK_KEYBOARD_H

{% if rgb_enabled %}
/* ─── RGB Matrix LED layout ─────────────────────────────────────────────────
 * Split keyboard : {{ matrix_rows - 1 }} main rows + 1 thumb row per half.
 * Left  : rows 0-{{ matrix_rows - 2 }} (main) + row {{ matrix_rows - 1 }} thumbs col 1-{{ matrix_cols - 1 }}.
 * Right : rows {{ matrix_rows }}-{{ matrix_rows * 2 - 2 }} (main) + row {{ matrix_rows * 2 - 1 }} thumbs col 0-{{ matrix_cols - 2 }}.
 * NOTE  : Matrix row pins (GP29/GP28/…) are defaults for Sea Picro Sofle v2.
 *         Adjust in info.json if your PCB uses different pins.
 */
{% set half_rows = matrix_rows - 1 %}
{% set leds_per_half = half_rows * matrix_cols + (matrix_cols - 1) %}
{% set total_leds = leds_per_half * 2 %}
{% set step = 18 %}
{% set gap = (matrix_cols + 1) * step %}
{% set thumb_y = (half_rows - 1) * 16 + 12 %}

led_config_t g_led_config = {
    { /* Key matrix → LED index (MATRIX_ROWS × MATRIX_COLS) */
{% for row in range(half_rows) %}
        { {% for col in range(matrix_cols) %}{{ row * matrix_cols + col }}, {% endfor %}},  /* left row {{ row }} */
{% endfor %}
        { NO_LED, {% for col in range(1, matrix_cols) %}{{ half_rows * matrix_cols + col - 1 }}, {% endfor %}},  /* left thumbs */
{% for row in range(half_rows) %}
        { {% for col in range(matrix_cols) %}{{ leds_per_half + row * matrix_cols + col }}, {% endfor %}},  /* right row {{ row }} */
{% endfor %}
        { {% for col in range(matrix_cols - 1) %}{{ leds_per_half + half_rows * matrix_cols + col }}, {% endfor %}NO_LED, },  /* right thumbs */
    },
    { /* LED index → physical position (x: 0–224, y: 0–64) */
{% for row in range(half_rows) %}
{% for col in range(matrix_cols) %}
        { {{ col * step }}, {{ row * 16 }} },
{% endfor %}
{% endfor %}
{% for col in range(1, matrix_cols) %}
        { {{ col * step }}, {{ thumb_y }} },
{% endfor %}
{% for row in range(half_rows) %}
{% for col in range(matrix_cols) %}
        { {{ col * step + gap }}, {{ row * 16 }} },
{% endfor %}
{% endfor %}
{% for col in range(matrix_cols - 1) %}
        { {{ col * step + gap }}, {{ thumb_y }} },
{% endfor %}
    },
    { /* LED flags — all key backlights */
{% for i in range(total_leds) %}
        LED_FLAG_KEYLIGHT,
{% endfor %}
    },
};
{% endif %}
