// Generated by keyboard_firmware_maker
// Keyboard : {{ keyboard_model }} / MCU : {{ mcu }}
// DO NOT EDIT — regenerate from the application

#pragma once

/* Matrix */
#define MATRIX_ROWS {{ matrix_rows * 2 }}
#define MATRIX_COLS {{ matrix_cols }}

{% if rgb_enabled %}
/* RGB Matrix */
{% set leds_per_half = (matrix_rows - 1) * matrix_cols + (matrix_cols - 1) %}
#define RGB_MATRIX_LED_COUNT {{ leds_per_half * 2 }}
#define RGB_MATRIX_SPLIT     { {{ leds_per_half }}, {{ leds_per_half }} }
{% if mcu == "rp2040" %}
#define WS2812_DI_PIN GP6
{% else %}
#define WS2812_DI_PIN D3
{% endif %}
#define RGB_MATRIX_MAXIMUM_BRIGHTNESS 200
#define RGB_MATRIX_STARTUP_MODE       RGB_MATRIX_SOLID_COLOR
#define RGB_MATRIX_STARTUP_HUE        0
#define RGB_MATRIX_STARTUP_SAT        255
#define RGB_MATRIX_STARTUP_VAL        128
{% endif %}

{% if oled_enabled %}
/* OLED */
#define OLED_DISPLAY_128X32
{% if oled_sleep %}
#define OLED_TIMEOUT {{ oled_sleep_timeout_ms }}
{% endif %}
{% endif %}

{% if rgb_sleep %}
/* RGB Matrix sleep */
#define RGB_MATRIX_TIMEOUT {{ oled_sleep_timeout_ms }}
#define RGB_MATRIX_SLEEP
{% endif %}

/* Rotary encoders — pins defined in keyboard.json (info.json) */
#define ENCODER_MAP_KEY_DELAY 10

/* Split keyboard serial */
{% if mcu == "rp2040" %}
#define SERIAL_USART_TX_PIN GP1
{% else %}
#define SOFT_SERIAL_PIN D1
{% endif %}

/* Vial */
#define VIAL_KEYBOARD_UID { {{ vial_uid }} }
#define VIAL_UNLOCK_COMBO_ROWS { 0, {{ matrix_rows }}, {{ matrix_rows - 1 }}, {{ matrix_rows * 2 - 1 }} }
#define VIAL_UNLOCK_COMBO_COLS { 0, 0, 0, 0 }
