{
    "keyboard_name": "{{ vial_name }}",
    "url": "",
    "maintainer": "keyboard_firmware_maker",
    "manufacturer": "keyboard_firmware_maker",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "0.0.1"
    },
    "features": {
{% if has_encoder and pins.encoder_a %}
        "encoder": true,
{% endif %}
        "extrakey": true
    },
{% if has_encoder and pins.encoder_a %}
    "encoder": {
        "rotary": [
            { "pin_a": "{{ pins.encoder_a[0] }}", "pin_b": "{{ pins.encoder_b[0] }}", "resolution": 2 }
        ]
    },
{% endif %}
{% if split %}
    "split": {
        "enabled": true,
{% if has_encoder and pins.encoder_a %}
        "encoder": {
            "right": {
                "rotary": [
{% if pins.encoder_a_right %}
                    { "pin_a": "{{ pins.encoder_a_right[0] }}", "pin_b": "{{ pins.encoder_b_right[0] }}", "resolution": 2 }
{% else %}
                    { "pin_a": "{{ pins.encoder_a[0] }}", "pin_b": "{{ pins.encoder_b[0] }}", "resolution": 2 }
{% endif %}
                ]
            }
        },
{% endif %}
        "transport": {
            "sync": {
                "oled": true,
                "wpm": true
            }
        }
    },
{% endif %}
    "diode_direction": "{{ diode_direction }}",
{% if pins.matrix_rows %}
    "matrix_pins": {
        "rows": {{ pins.matrix_rows | tojson }},
        "cols": {{ pins.matrix_cols | tojson }}
    },
{% endif %}
{% if native_layouts_json %}
    "layouts": {{ native_layouts_json }}
{% else %}
    "layouts": {
        "{{ layout_macro }}": {
            "layout": [
{% for key in vial_keys %}
                {"matrix": [{{ key.matrix_row }}, {{ key.matrix_col }}], "x": {{ key.x }}, "y": {{ key.y }}{% if key.w is defined %}, "w": {{ key.w }}{% endif %}{% if key.h is defined %}, "h": {{ key.h }}{% endif %}}{% if not loop.last %},{% endif %}

{% endfor %}
            ]
        }
    }
{% endif %}
}
