{%- if split -%}
{%- set half_rows = matrix_rows - 1 -%}
{%- set gap = matrix_cols + 1 -%}
{%- set ns = namespace(keys=[]) -%}
{%- for row in range(half_rows) -%}
  {%- for col in range(matrix_cols) -%}
    {%- set ns.keys = ns.keys + [[row, col, col, row]] -%}
  {%- endfor -%}
  {%- for col in range(matrix_cols) -%}
    {%- set ns.keys = ns.keys + [[row + matrix_rows, col, col + gap, row]] -%}
  {%- endfor -%}
{%- endfor -%}
{%- for col in range(1, matrix_cols) -%}
  {%- set ns.keys = ns.keys + [[half_rows, col, col, half_rows]] -%}
{%- endfor -%}
{%- for col in range(1, matrix_cols) -%}
  {%- set ns.keys = ns.keys + [[half_rows + matrix_rows, col, col + gap, half_rows]] -%}
{%- endfor -%}
{%- endif -%}
{
    "keyboard_name": "{{ vial_name }}",
    "url": "",
    "maintainer": "keyboard_firmware_maker",
    "manufacturer": "keyboard_firmware_maker",
    "usb": {
        "vid": "0xFEED",
        "pid": "0x0001",
        "device_version": "0.0.1"
    },
    "features": {
{% if has_encoder %}
        "encoder": true,
{% endif %}
        "extrakey": true
    },
{% if has_encoder %}
    "encoder": {
        "rotary": [
{% if pins.encoder_a %}
            { "pin_a": "{{ pins.encoder_a[0] }}", "pin_b": "{{ pins.encoder_b[0] }}", "resolution": 2 }
{% endif %}
        ]
    },
{% endif %}
{% if split %}
    "split": {
        "enabled": true,
{% if has_encoder %}
        "encoder": {
            "right": {
                "rotary": [
{% if pins.encoder_a_right %}
                    { "pin_a": "{{ pins.encoder_a_right[0] }}", "pin_b": "{{ pins.encoder_b_right[0] }}", "resolution": 2 }
{% elif pins.encoder_a %}
                    { "pin_a": "{{ pins.encoder_a[0] }}", "pin_b": "{{ pins.encoder_b[0] }}", "resolution": 2 }
{% endif %}
                ]
            }
        },
{% endif %}
        "transport": {
            "sync": {
                "oled": true,
                "wpm": true
            }
        }
    },
{% endif %}
    "diode_direction": "{{ diode_direction }}",
{% if pins.matrix_rows %}
    "matrix_pins": {
        "rows": {{ pins.matrix_rows | tojson }},
        "cols": {{ pins.matrix_cols | tojson }}
    },
{% endif %}
    "layouts": {
        "{{ layout_macro }}": {
            "layout": [
{% if split %}
{% for key in ns.keys %}
                {"matrix": [{{ key[0] }}, {{ key[1] }}], "x": {{ key[2] }}, "y": {{ key[3] }}}{% if not loop.last %},{% endif %}

{% endfor %}
{% else %}
{% for key in vial_keys %}
                {"matrix": [{{ key.matrix_row }}, {{ key.matrix_col }}], "x": {{ key.x }}, "y": {{ key.y }}}{% if not loop.last %},{% endif %}

{% endfor %}
{% endif %}
            ]
        }
    }
}
