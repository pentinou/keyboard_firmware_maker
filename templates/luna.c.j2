/* ── Animation state ────────────────────────────────────────────────────── */

typedef enum { LUNA_SIT, LUNA_WALK, LUNA_RUN, LUNA_BARK, LUNA_SNEAK } luna_state_t;

static uint8_t       luna_frame    = 0;
static luna_state_t  luna_state    = LUNA_SIT;
static uint32_t      luna_timer    = 0;

/* Write one Luna frame starting at page `line` (col always 0, 32px wide). */
static void _luna_draw(uint8_t line, const uint8_t *frame) {
    oled_set_cursor(0, line);
    oled_write_raw_P((const char *)frame, LUNA_SIZE);  /* 96 bytes = 3 pages × 32 cols */
}

/* Call from oled_task_user() : line = page (0-15). Luna always at col 0. */
void render_luna(uint8_t line) {
    /* Determine state from modifiers / WPM */
    const uint8_t wpm = get_current_wpm();
    led_t leds        = host_keyboard_led_state();
    const uint8_t mods = get_mods() | get_oneshot_mods();

    luna_state_t next;
    if (leds.caps_lock) {
        next = LUNA_BARK;
    } else if (mods & MOD_MASK_SHIFT) {
        next = LUNA_SNEAK;
    } else if (wpm >= LUNA_RUN_SPEED) {
        next = LUNA_RUN;
    } else if (wpm >= LUNA_WALK_SPEED) {
        next = LUNA_WALK;
    } else {
        next = LUNA_SIT;
    }

    /* Reset frame counter on state change */
    if (next != luna_state) {
        luna_state = next;
        luna_frame = 0;
        luna_timer = timer_read32();
    }

    /* Advance frame on timer */
    if (timer_elapsed32(luna_timer) >= LUNA_FRAME_DELAY) {
        luna_timer = timer_read32();
        switch (luna_state) {
            case LUNA_SIT:   luna_frame = (luna_frame + 1) % 2; break;
            case LUNA_WALK:  luna_frame = (luna_frame + 1) % 2; break;
            case LUNA_RUN:   luna_frame = (luna_frame + 1) % 2; break;
            case LUNA_BARK:  luna_frame = (luna_frame + 1) % 2; break;
            case LUNA_SNEAK: luna_frame = (luna_frame + 1) % 2; break;
        }
    }

    /* Render current frame */
    switch (luna_state) {
        case LUNA_SIT:   _luna_draw(line, luna_sit[luna_frame]);   break;
        case LUNA_WALK:  _luna_draw(line, luna_walk[luna_frame]);  break;
        case LUNA_RUN:   _luna_draw(line, luna_run[luna_frame]);   break;
        case LUNA_BARK:  _luna_draw(line, luna_bark[luna_frame]);  break;
        case LUNA_SNEAK: _luna_draw(line, luna_sneak[luna_frame]); break;
    }
}
