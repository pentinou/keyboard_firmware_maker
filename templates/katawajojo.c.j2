/* ── Animation state ────────────────────────────────────────────────────── */

typedef enum { KATAWAJOJO_SIT, KATAWAJOJO_WALK, KATAWAJOJO_RUN, KATAWAJOJO_BARK, KATAWAJOJO_SNEAK } katawajojo_state_t;

static uint8_t       katawajojo_frame    = 0;
static katawajojo_state_t  katawajojo_state    = KATAWAJOJO_SIT;
static uint32_t      katawajojo_timer    = 0;

/* Write one KatawaJojo frame starting at page `line` (col always 0, 32px wide). */
static void _katawajojo_draw(uint8_t line, const uint8_t *frame) {
    oled_set_cursor(0, line);
    oled_write_raw_P((const char *)frame, KATAWAJOJO_SIZE);  /* 96 bytes = 3 pages × 32 cols */
}

/* Call from oled_task_user() : line = page (0-15). KatawaJojo always at col 0. */
void render_katawajojo(uint8_t line) {
    /* Determine state from modifiers / WPM */
    const uint8_t wpm = get_current_wpm();
    led_t leds        = host_keyboard_led_state();
    const uint8_t mods = get_mods() | get_oneshot_mods();

    katawajojo_state_t next;
    if (leds.caps_lock) {
        next = KATAWAJOJO_BARK;
    } else if (mods & MOD_MASK_SHIFT) {
        next = KATAWAJOJO_SNEAK;
    } else if (wpm >= KATAWAJOJO_RUN_SPEED) {
        next = KATAWAJOJO_RUN;
    } else if (wpm >= KATAWAJOJO_WALK_SPEED) {
        next = KATAWAJOJO_WALK;
    } else {
        next = KATAWAJOJO_SIT;
    }

    /* Reset frame counter on state change */
    if (next != katawajojo_state) {
        katawajojo_state = next;
        katawajojo_frame = 0;
        katawajojo_timer = timer_read32();
    }

    /* Advance frame on timer */
    if (timer_elapsed32(katawajojo_timer) >= KATAWAJOJO_FRAME_DELAY) {
        katawajojo_timer = timer_read32();
        switch (katawajojo_state) {
            case KATAWAJOJO_SIT:   katawajojo_frame = (katawajojo_frame + 1) % 2; break;
            case KATAWAJOJO_WALK:  katawajojo_frame = (katawajojo_frame + 1) % 4; break;
            case KATAWAJOJO_RUN:   katawajojo_frame = (katawajojo_frame + 1) % 2; break;
            case KATAWAJOJO_BARK:  katawajojo_frame = (katawajojo_frame + 1) % 3; break;
            case KATAWAJOJO_SNEAK: katawajojo_frame = (katawajojo_frame + 1) % 4; break;
        }
    }

    /* Render current frame */
    switch (katawajojo_state) {
        case KATAWAJOJO_SIT:   _katawajojo_draw(line, katawajojo_sit[katawajojo_frame]);   break;
        case KATAWAJOJO_WALK:  _katawajojo_draw(line, katawajojo_walk[katawajojo_frame]);  break;
        case KATAWAJOJO_RUN:   _katawajojo_draw(line, katawajojo_run[katawajojo_frame]);   break;
        case KATAWAJOJO_BARK:  _katawajojo_draw(line, katawajojo_bark[katawajojo_frame]);  break;
        case KATAWAJOJO_SNEAK: _katawajojo_draw(line, katawajojo_sneak[katawajojo_frame]); break;
    }
}
