{% if anti_burnin %}
/* ─── Anti burn-in ─────────────────────────────────────────────────────────
 * Toutes les 60 s : inversion matérielle 1 s + décalage 1 pixel aléatoire.
 * Réduit le marquage des éléments fixes sur l'écran OLED.              */
extern uint8_t  oled_buffer[OLED_MATRIX_SIZE];
extern uint16_t oled_dirty;

static uint32_t _burnin_timer  = 0;
static bool     _burnin_active = false;
static uint8_t  _burnin_dir    = 0; /* 0=droite 1=gauche 2=haut 3=bas */

static void _burnin_apply(void) {
    if (_burnin_active) {
        if (timer_elapsed32(_burnin_timer) >= 1000) {
            _burnin_active = false;
            _burnin_timer  = timer_read32();
            oled_invert(false);
            return;
        }
        /* Décalage 1 pixel dans la direction choisie */
        uint8_t p, c;
        switch (_burnin_dir) {
            case 0: { /* Droite */
                for (p = 0; p < OLED_MATRIX_SIZE / OLED_DISPLAY_HEIGHT; p++) {
                    uint16_t b = (uint16_t)p * OLED_DISPLAY_HEIGHT;
                    memmove(&oled_buffer[b + 1], &oled_buffer[b], OLED_DISPLAY_HEIGHT - 1);
                    oled_buffer[b] = 0;
                }
                break;
            }
            case 1: { /* Gauche */
                for (p = 0; p < OLED_MATRIX_SIZE / OLED_DISPLAY_HEIGHT; p++) {
                    uint16_t b = (uint16_t)p * OLED_DISPLAY_HEIGHT;
                    memmove(&oled_buffer[b], &oled_buffer[b + 1], OLED_DISPLAY_HEIGHT - 1);
                    oled_buffer[b + OLED_DISPLAY_HEIGHT - 1] = 0;
                }
                break;
            }
            case 2: { /* Haut */
                for (c = 0; c < OLED_DISPLAY_HEIGHT; c++) {
                    uint8_t pages = OLED_MATRIX_SIZE / OLED_DISPLAY_HEIGHT;
                    for (p = 0; p < pages - 1; p++) {
                        uint8_t carry = (oled_buffer[(uint16_t)(p + 1) * OLED_DISPLAY_HEIGHT + c] & 0x01) << 7;
                        oled_buffer[(uint16_t)p * OLED_DISPLAY_HEIGHT + c] =
                            (oled_buffer[(uint16_t)p * OLED_DISPLAY_HEIGHT + c] >> 1) | carry;
                    }
                    oled_buffer[(uint16_t)(pages - 1) * OLED_DISPLAY_HEIGHT + c] >>= 1;
                }
                break;
            }
            default: { /* Bas */
                uint8_t pages = OLED_MATRIX_SIZE / OLED_DISPLAY_HEIGHT;
                for (c = 0; c < OLED_DISPLAY_HEIGHT; c++) {
                    for (p = pages - 1; p > 0; p--) {
                        uint8_t carry = (oled_buffer[(uint16_t)(p - 1) * OLED_DISPLAY_HEIGHT + c] & 0x80) >> 7;
                        oled_buffer[(uint16_t)p * OLED_DISPLAY_HEIGHT + c] =
                            (oled_buffer[(uint16_t)p * OLED_DISPLAY_HEIGHT + c] << 1) | carry;
                    }
                    oled_buffer[c] <<= 1;
                }
                break;
            }
        }
        oled_dirty = 0xFFFF; /* Forcer rafraîchissement complet */
    } else {
        if (timer_elapsed32(_burnin_timer) >= 60000) {
            _burnin_active = true;
            _burnin_dir    = (uint8_t)(timer_read32() & 3);
            _burnin_timer  = timer_read32();
            oled_invert(true);
        }
    }
}
