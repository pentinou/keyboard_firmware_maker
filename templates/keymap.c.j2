static void render_rgb_mode(uint8_t col, uint8_t line) {
    uint8_t mode = rgb_matrix_get_mode();
    oled_set_cursor(col, line);
    oled_write_P(PSTR("RGB :"), false);
    /* Separator bar — just below "RGB :" */
    oled_set_cursor(0, line + 1);
    oled_write_raw_P(oled_sep, sizeof(oled_sep));
    /* Mode name — 2 lines of 5 chars */
    if (mode < RGB_NAME_COUNT) {
        char buf[6];
        memcpy_P(buf, rgb_name[mode], 5);
        buf[5] = '\0';
        oled_set_cursor(col, line + 2);
        oled_write(buf, false);
        memcpy_P(buf, rgb_name[mode] + 5, 5);
        buf[5] = '\0';
        oled_set_cursor(col, line + 3);
        oled_write(buf, false);
    } else {
        oled_set_cursor(col, line + 2);
        oled_write_P(PSTR("Mode "), false);
        oled_set_cursor(col, line + 3);
        oled_write(get_u8_str(mode, ' '), false);
    }
}
