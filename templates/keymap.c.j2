{% if per_key_colors %}
/* Per-key color overlay — applies on top of the active RGB effect.
 * Colors are set via the keyboard_firmware_maker UI. */
bool rgb_matrix_indicators_user(void) {
{% for key_id, hex_color in per_key_colors.items() %}
{% set side = key_id[0] %}
{% set rc = key_id[2:].split('_') %}
{% set row_num = rc[0][1:] | int %}
{% set col_num = rc[1][1:] | int %}
{% if split %}
{% if side == 'R' %}
{% set actual_row = row_num + matrix_rows %}
{% else %}
{% set actual_row = row_num %}
{% endif %}
{% else %}
{% set actual_row = row_num %}
{% endif %}
    { uint8_t led = g_led_config.matrix_co[{{ actual_row }}][{{ col_num }}];
      if (led != NO_LED) rgb_matrix_set_color(led, 0x{{ hex_color[1:3] }}, 0x{{ hex_color[3:5] }}, 0x{{ hex_color[5:7] }}); }
{% endfor %}
    return false;
}
{% endif %}

{% if has_reactive_effects %}
uint8_t  _ripple_last_x = 128;
uint8_t  _ripple_last_y = 32;
uint16_t _ripple_timer  = 0;
bool     _ripple_active = false;

bool process_record_user(uint16_t keycode, keyrecord_t *record) {
    if (record->event.pressed) {
        uint8_t row = record->event.key.row;
        uint8_t col = record->event.key.col;
        uint8_t led = g_led_config.matrix_co[row][col];
        if (led != NO_LED) {
            _ripple_last_x = g_led_config.point[led].x;
            _ripple_last_y = g_led_config.point[led].y;
            _ripple_timer  = timer_read();
            _ripple_active = true;
        }
    }
    return true;
}
{% endif %}
