{% if rgb_sleep and not oled_enabled %}
/* RGB sleep without OLED — need housekeeping to manage RGB power.
 * When OLED is present, this is handled inside oled_task_user(). */
void housekeeping_task_user(void) {
    if (last_input_activity_elapsed() > RGB_SLEEP_TIMEOUT) {
        if (rgb_matrix_is_enabled()) { rgb_matrix_disable_noeeprom(); }
    } else {
        if (!rgb_matrix_is_enabled()) { rgb_matrix_enable_noeeprom(); }
    }
}
