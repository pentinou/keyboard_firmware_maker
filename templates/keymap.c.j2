bool oled_task_user(void) {
{% if oled_sleep %}
    /* Manual sleep — built-in OLED_TIMEOUT / RGB_MATRIX_SLEEP are unreliable
     * in Vial-QMK on split keyboards (activity timer not always synced).
     * We handle both OLED and RGB sleep explicitly here. */
    if (last_input_activity_elapsed() > OLED_TIMEOUT) {
        oled_off();
{% if rgb_sleep %}
        if (rgb_matrix_is_enabled()) { rgb_matrix_disable_noeeprom(); }
{% endif %}
        return false;
    }
    if (!is_oled_on()) { oled_on(); }
{% if rgb_sleep %}
    if (!rgb_matrix_is_enabled()) { rgb_matrix_enable_noeeprom(); }
{% endif %}
{% else %}
    if (!is_oled_on()) return false;
{% endif %}
{% if left_ocean_dream_enabled and right_ocean_dream_enabled %}
    /* Ocean Dream uses pixel-level drawing — never clear */
{% elif left_ocean_dream_enabled %}
    if (!is_keyboard_left()) { oled_clear(); }
{% elif right_ocean_dream_enabled %}
    if (is_keyboard_left()) { oled_clear(); }
{% else %}
    oled_clear();
{% endif %}
    if (is_keyboard_left()) {
        /* ── LEFT OLED ─────────────────────────────── */
{% if left_images %}
{% for img in left_images %}
        oled_set_cursor(0, 0);
{% if img.frames | length > 1 %}
        {
            static const uint16_t left_img{{ img.idx }}_delays[] = { {{ img.delays | join(', ') }} };
            static uint32_t left_img{{ img.idx }}_timer = 0;
            static uint8_t  left_img{{ img.idx }}_idx   = 0;
            if (timer_elapsed32(left_img{{ img.idx }}_timer) > left_img{{ img.idx }}_delays[left_img{{ img.idx }}_idx]) {
                left_img{{ img.idx }}_timer = timer_read32();
                left_img{{ img.idx }}_idx   = (left_img{{ img.idx }}_idx + 1) % {{ img.frames | length }};
            }
            switch (left_img{{ img.idx }}_idx) {
{% for frame in img.frames %}
                case {{ loop.index0 }}: oled_write_raw_P((const char *)left_img{{ img.idx }}_frame{{ loop.index0 }}, sizeof(left_img{{ img.idx }}_frame{{ loop.index0 }})); break;
{% endfor %}
            }
        }
{% else %}
        oled_write_raw_P((const char *)left_img{{ img.idx }}_frame0, sizeof(left_img{{ img.idx }}_frame0));
{% endif %}
{% endfor %}
{% endif %}
{% if left_layer.enabled %}
        oled_set_cursor({{ left_layer.col }}, {{ left_layer.line }});
        oled_write_P(PSTR("LAYER"), false);
        oled_set_cursor(0, {{ left_layer.line + 1 }});
        oled_write_raw_P(oled_sep, sizeof(oled_sep));
        oled_set_cursor({{ left_layer.col }}, {{ left_layer.line + 2 }});
        oled_write(get_u8_str(get_highest_layer(layer_state), ' '), false);
{% endif %}
{% if left_caps_lock.enabled %}
        oled_set_cursor({{ left_caps_lock.col }}, {{ left_caps_lock.line }});
        oled_write_P(PSTR("Caps:"), false);
        oled_set_cursor(0, {{ left_caps_lock.line + 1 }});
        oled_write_raw_P(oled_sep, sizeof(oled_sep));
        { led_t l = host_keyboard_led_state();
            oled_set_cursor({{ left_caps_lock.col }}, {{ left_caps_lock.line + 2 }});
            oled_write_P(l.caps_lock ? PSTR("ON   ") : PSTR("OFF  "), false); }
{% endif %}
{% if left_wpm.enabled %}
        oled_set_cursor({{ left_wpm.col }}, {{ left_wpm.line }});
        oled_write(get_u8_str(get_current_wpm(), ' '), false);
{% endif %}
{% if left_rgb_mode.enabled %}
        render_rgb_mode({{ left_rgb_mode.col }}, {{ left_rgb_mode.line }});
{% endif %}
{% if left_katawajojo_enabled %}
        render_katawajojo({{ left_katawajojo_line }});
{% endif %}
{% if left_luna_enabled %}
        render_luna({{ left_luna_line }});
{% endif %}
{% if left_ocean_dream_enabled %}
        render_ocean_dream();
{% endif %}
{% if left_bongo_enabled %}
        oled_set_cursor(0, {{ left_bongo_line }});
        render_anim_bongocat();
{% endif %}
{% if left_crab_enabled %}
        oled_render_anim();
{% endif %}
{% if left_kfm.enabled %}
        /* KFM rendered last so it overlays on animations */
        oled_set_cursor({{ left_kfm.col }}, {{ left_kfm.line }});
        oled_write_P(PSTR("<KFM>"), false);
{% endif %}
    } else {
        /* ── RIGHT OLED ─────────────────────────────── */
{% if right_images %}
{% for img in right_images %}
        oled_set_cursor(0, 0);
{% if img.frames | length > 1 %}
        {
            static const uint16_t right_img{{ img.idx }}_delays[] = { {{ img.delays | join(', ') }} };
            static uint32_t right_img{{ img.idx }}_timer = 0;
            static uint8_t  right_img{{ img.idx }}_idx   = 0;
            if (timer_elapsed32(right_img{{ img.idx }}_timer) > right_img{{ img.idx }}_delays[right_img{{ img.idx }}_idx]) {
                right_img{{ img.idx }}_timer = timer_read32();
                right_img{{ img.idx }}_idx   = (right_img{{ img.idx }}_idx + 1) % {{ img.frames | length }};
            }
            switch (right_img{{ img.idx }}_idx) {
{% for frame in img.frames %}
                case {{ loop.index0 }}: oled_write_raw_P((const char *)right_img{{ img.idx }}_frame{{ loop.index0 }}, sizeof(right_img{{ img.idx }}_frame{{ loop.index0 }})); break;
{% endfor %}
            }
        }
{% else %}
        oled_write_raw_P((const char *)right_img{{ img.idx }}_frame0, sizeof(right_img{{ img.idx }}_frame0));
{% endif %}
{% endfor %}
{% endif %}
{% if right_layer.enabled %}
        oled_set_cursor({{ right_layer.col }}, {{ right_layer.line }});
        oled_write_P(PSTR("LAYER"), false);
        oled_set_cursor(0, {{ right_layer.line + 1 }});
        oled_write_raw_P(oled_sep, sizeof(oled_sep));
        oled_set_cursor({{ right_layer.col }}, {{ right_layer.line + 2 }});
        oled_write(get_u8_str(get_highest_layer(layer_state), ' '), false);
{% endif %}
{% if right_caps_lock.enabled %}
        oled_set_cursor({{ right_caps_lock.col }}, {{ right_caps_lock.line }});
        oled_write_P(PSTR("Caps:"), false);
        oled_set_cursor(0, {{ right_caps_lock.line + 1 }});
        oled_write_raw_P(oled_sep, sizeof(oled_sep));
        { led_t l = host_keyboard_led_state();
            oled_set_cursor({{ right_caps_lock.col }}, {{ right_caps_lock.line + 2 }});
            oled_write_P(l.caps_lock ? PSTR("ON   ") : PSTR("OFF  "), false); }
{% endif %}
{% if right_wpm.enabled %}
        oled_set_cursor({{ right_wpm.col }}, {{ right_wpm.line }});
        oled_write(get_u8_str(get_current_wpm(), ' '), false);
{% endif %}
{% if right_rgb_mode.enabled %}
        render_rgb_mode({{ right_rgb_mode.col }}, {{ right_rgb_mode.line }});
{% endif %}
{% if right_katawajojo_enabled %}
        render_katawajojo({{ right_katawajojo_line }});
{% endif %}
{% if right_luna_enabled %}
        render_luna({{ right_luna_line }});
{% endif %}
{% if right_ocean_dream_enabled %}
        render_ocean_dream();
{% endif %}
{% if right_bongo_enabled %}
        oled_set_cursor(0, {{ right_bongo_line }});
        render_anim_bongocat();
{% endif %}
{% if right_crab_enabled %}
        oled_render_anim();
{% endif %}
{% if right_kfm.enabled %}
        /* KFM rendered last so it overlays on animations */
        oled_set_cursor({{ right_kfm.col }}, {{ right_kfm.line }});
        oled_write_P(PSTR("<KFM>"), false);
{% endif %}
    }
{% if anti_burnin %}
    _burnin_apply();
{% endif %}
    return false;
}
