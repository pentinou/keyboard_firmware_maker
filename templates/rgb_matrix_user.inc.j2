    uint16_t _raw_elapsed = timer_elapsed(_te{{ loop.index0 }}_timer);
    uint16_t _elapsed = _raw_elapsed % {{ te.loop_ms }}U;
    if (_elapsed > {{ te.total_duration }}U) _elapsed = {{ te.total_duration }}U;
{% endif %}

    for (uint8_t i = led_min; i < led_max; i++) {
        RGB_MATRIX_TEST_LED_FLAGS();
        uint8_t _r = 0, _g = 0, _b = 0;
{% for track in te.tracks %}

        // — {{ track.name }} ({{ track.target_mode }}) —
{% if track.target_mode == "fixed" and track.matrix_positions %}
        if ({% for pos in track.matrix_positions %}i == g_led_config.matrix_co[{{ pos.row }}][{{ pos.col }}]{% if not loop.last %} || {% endif %}{% endfor %}) {
{% if te.effect_type == "ambient" %}
            uint16_t t = _elapsed;
{% else %}{# reactive fixed: use most recent hit #}
            uint16_t t = {{ te.total_duration }}U;
            if (g_last_hit.count > 0) {
                t = timer_elapsed(g_last_hit.tick[g_last_hit.count - 1]);
                if (t > {{ te.total_duration }}U) t = {{ te.total_duration }}U;
            }
{% endif %}
{{ render_steps(track.steps, "            ") }}
        }
{% elif track.target_mode == "relative" and track.key_offsets and te.effect_type == "reactive" %}
        // Reactive relative: animate offset keys around the pressed key
        for (uint8_t _h = 0; _h < g_last_hit.count; _h++) {
            uint16_t t = timer_elapsed(g_last_hit.tick[_h]);
            if (t > {{ te.total_duration }}U) continue;
            // Find (row, col) of the hit LED
            uint8_t _hit_led = g_last_hit.index[_h];
            int8_t _hit_row = -1, _hit_col = -1;
            for (uint8_t _mr = 0; _mr < MATRIX_ROWS; _mr++) {
                for (uint8_t _mc = 0; _mc < MATRIX_COLS; _mc++) {
