{# ── Timeline-based custom effects ── #}
{% for te in timeline_effects %}
bool {{ te.name }}(effect_params_t* params) {
    RGB_MATRIX_USE_LIMITS(led_min, led_max);
{% if te.effect_type == "ambient" %}
    // Ambient: timer statique qui boucle
    static uint16_t _te{{ loop.index0 }}_timer = 0;
