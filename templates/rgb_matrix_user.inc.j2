{% for e in custom_effects %}{% if e.type == "ripple" %}
bool {{ e.name }}(effect_params_t* params) {
    RGB_MATRIX_USE_LIMITS(led_min, led_max);
    uint16_t elapsed = _ripple_active ? timer_elapsed(_ripple_timer) : {{ e.fade_ms }};
    for (uint8_t i = led_min; i < led_max; i++) {
        RGB_MATRIX_TEST_LED_FLAGS();
        if (!_ripple_active || elapsed >= {{ e.fade_ms }}) {
            // fond dim (couleur secondaire / 8)
            rgb_matrix_set_color(i, {{ e.secondary_r }}/8, {{ e.secondary_g }}/8, {{ e.secondary_b }}/8);
        } else {
            int16_t  dx      = (int16_t)g_led_config.point[i].x - (int16_t)_ripple_last_x;
            int16_t  dy      = (int16_t)g_led_config.point[i].y - (int16_t)_ripple_last_y;
            uint32_t dist_sq = (uint32_t)(dx*dx) + (uint32_t)(dy*dy);
            uint16_t r       = (uint16_t)((uint32_t)elapsed * 230UL / {{ e.fade_ms }});
            uint8_t  hw      = 22;
            uint32_t rmin_sq = (r > hw) ? (uint32_t)(r-hw)*(r-hw) : 0;
            uint32_t rmax_sq = (uint32_t)(r+hw)*(r+hw);
            uint8_t  fade    = (uint8_t)(255 - (uint32_t)elapsed * 255 / {{ e.fade_ms }});
            if (dist_sq >= rmin_sq && dist_sq <= rmax_sq) {
                rgb_matrix_set_color(i,
                    (uint8_t)((uint16_t){{ e.primary_r }} * fade / 255),
                    (uint8_t)((uint16_t){{ e.primary_g }} * fade / 255),
                    (uint8_t)((uint16_t){{ e.primary_b }} * fade / 255));
            } else {
                rgb_matrix_set_color(i,
                    (uint8_t)((uint16_t){{ e.secondary_r }} * fade / 512),
                    (uint8_t)((uint16_t){{ e.secondary_g }} * fade / 512),
                    (uint8_t)((uint16_t){{ e.secondary_b }} * fade / 512));
            }
        }
    }
    if (elapsed >= {{ e.fade_ms }}) _ripple_active = false;
    return rgb_matrix_check_finished_leds(led_max);
}
