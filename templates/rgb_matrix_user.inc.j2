            if (_hit_row < 0) continue;
            // Check if current LED (i) matches any offset target
            bool _match = false;
{% for off in track.key_offsets %}
            { int8_t _tr = _hit_row + ({{ off.dr }}); int8_t _tc = _hit_col + ({{ off.dc }});
              if (_tr >= 0 && _tr < MATRIX_ROWS && _tc >= 0 && _tc < MATRIX_COLS &&
                  i == g_led_config.matrix_co[_tr][_tc]) _match = true; }
{% endfor %}
            if (!_match) continue;
{{ render_steps(track.steps, "            ") }}
        }
{% elif track.target_mode == "default" and te.effect_type == "reactive" %}
        // Reactive default: animate on the pressed key
        for (uint8_t _h = 0; _h < g_last_hit.count; _h++) {
            uint16_t t = timer_elapsed(g_last_hit.tick[_h]);
            if (t > {{ te.total_duration }}U) continue;
            if (i != g_last_hit.index[_h]) continue;
{{ render_steps(track.steps, "            ") }}
        }
{% endif %}
