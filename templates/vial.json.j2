{
    "name": "{{ vial_name }}",
    "vendorId": "{{ vial_vid }}",
    "productId": "{{ vial_pid }}",
{% if rgb_enabled %}
    "lighting": "qmk_rgblight",
{% endif %}
    "matrix": {
        "rows": {% if split %}{{ matrix_rows * 2 }}{% else %}{{ matrix_rows }}{% endif %},
        "cols": {{ matrix_cols }}
    },
    "layouts": {
        "keymap": [
            [
{% for key in vial_keys %}
                {"matrix": [{{ key.matrix_row }}, {{ key.matrix_col }}], "x": {{ key.x }}, "y": {{ key.y }}}{% if not loop.last %},{% endif %}

{% endfor %}
            ]
        ]
    }
}
